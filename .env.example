# ═══════════════════════════════════════════════════════════════
#  DataMind AI Analytics Platform — Environment Variables
#  Copy to .env and fill in your values
# ═══════════════════════════════════════════════════════════════

# ── Database ─────────────────────────────────────────────────
POSTGRES_DB=datamind
POSTGRES_USER=datamind
POSTGRES_PASSWORD=change_this_password

# SQLite fallback (for local dev without Docker)
# DATABASE_URL=sqlite:///./ai_analyst.db
DATABASE_URL=postgresql://datamind:change_this_password@localhost:5432/datamind

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Security ─────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-very-long-random-string-in-production

# ── AI / LLM ─────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-key-here

# Optional: local Ollama
USE_OLLAMA=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ── File Storage ──────────────────────────────────────────────
UPLOAD_DIR=./uploads

# ── Email (for alerts & scheduled reports) ───────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=noreply@datamind.ai

# ── Frontend ─────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8001

# ── CORS ─────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Environment ──────────────────────────────────────────────
ENVIRONMENT=development
