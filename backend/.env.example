# ─────────────────────────────────────────────────────────────────────────────
# DataMind AI — Backend Environment Variables
# Copy this file to .env and fill in your values.
# Lines starting with # are comments and are ignored.
# ─────────────────────────────────────────────────────────────────────────────


# ── Database ──────────────────────────────────────────────────────────────────

# SQLite (default, works out of the box — good for local dev & demos)
DATABASE_URL=sqlite:///./ai_analyst.db

# PostgreSQL (recommended for production)
# DATABASE_URL=postgresql://user:password@localhost:5432/datamind


# ── Security ──────────────────────────────────────────────────────────────────

# REQUIRED: Random secret used to sign JWT tokens.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-secure-random-string-in-production


# ── File Storage ──────────────────────────────────────────────────────────────

# Directory where uploaded dataset files are stored.
UPLOAD_DIR=./uploads


# ── AI / LLM Providers ────────────────────────────────────────────────────────

# Anthropic Claude (enables AI Agent, Chat with Data, Auto Analyst, etc.)
# Get your key at: https://console.anthropic.com/
# OPTIONAL — AI features fall back gracefully when not set.
ANTHROPIC_API_KEY=

# OpenAI GPT (alternative AI provider — used if Anthropic key is absent)
# Get your key at: https://platform.openai.com/
# OPTIONAL
OPENAI_API_KEY=

# Google Gemini (additional AI provider option)
# OPTIONAL
GOOGLE_API_KEY=

# Ollama (local AI — zero cost, runs entirely on your machine)
# Install Ollama: https://ollama.ai  then run: ollama pull llama3
# OPTIONAL — used as fallback when cloud API keys are absent
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3


# ── CORS / Allowed Origins ────────────────────────────────────────────────────

# Comma-separated list of allowed frontend origins.
# Defaults to localhost:3000-3009 in development.
# In production, set this to your actual domain(s).
# ALLOWED_ORIGINS=https://datamind.yourdomain.com,https://www.yourdomain.com


# ── Application ───────────────────────────────────────────────────────────────

# "development" enables Swagger UI at /docs; "production" disables it.
ENVIRONMENT=development


# ── SuperAdmin Account ────────────────────────────────────────────────────────

# Created automatically on first startup. Used for admin panel access.
# Change these before deploying to production!
SUPERADMIN_EMAIL=admin@datamind.ai
SUPERADMIN_PASSWORD=Admin@DataMind2026


# ── Redis (optional — required only for Celery background tasks) ──────────────

# If not set, background tasks run synchronously (slower but functional).
# REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0


# ── Email / SMTP (optional — required for scheduled reports & alerts) ─────────

# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=DataMind AI <noreply@datamind.ai>
